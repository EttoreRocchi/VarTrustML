<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
    <style>
        {{ css_content }}
    </style>
</head>
<body>
    <h1>{{ title }}</h1>
    <p><em>{{ subtitle }}</em></p>
    <p class="timestamp">Report generated: {{ timestamp }}</p>

    {% for section in sections %}
    {{ section | safe }}
    {% endfor %}

    <script>
        {{ js_content }}
    </script>
</body>
</html>
